# SHOCKME · copy to .env  ->  cp .env.example .env
# run/bff.sh sources this automatically if it exists.

# the site
PORT=3400

# the engine (REQUIRED)
NEDB_URL=http://127.0.0.1:7070
NEDB_DB=shockme

# the voice. 1 = imagine writes the room. 0 = 58-line curated corpus.
# If this is 1 and nothing answers on IMAGINE_URL, the site still works —
# it prints a loud banner and falls back. Check: curl -s localhost:3400/health
# Visitors speaking into the room. DEFAULT ON.
# Set 0 and restart to make the room read-only instantly, without a deploy.
SHOCKME_CHAT=1

# Extra blocked terms, comma separated, on top of the built-in list.
# SHOCKME_BLOCKLIST=term,another

SHOCKME_IMAGINE=1
IMAGINE_URL=http://127.0.0.1:8081

# The back room: https://thrilling.world/admin?k=<token>
# Must be 16+ chars. UNSET means /admin returns a plain 404 — not "disabled",
# not 401 — so a scanner cannot learn the panel exists.
#   openssl rand -hex 24
# SHOCKME_ADMIN_TOKEN=

# Salt for the shared world. Change it and EVERY visitor's room changes.
# Keep it stable in production — rotating it mid-session rewrites the room
# under people who are standing in it.
SHOCKME_WORLD_SEED=the-room-remembers

# Public origin. Used for OG tags and share links, which must be absolute —
# a relative URL in og:image does not unfurl anywhere.
SHOCKME_ORIGIN=http://127.0.0.1:3400

# ---- production only ----
# SHOCKME_ORIGIN=https://thrilling.world
# Ports differ on the VPS because Vision and NEDB Studio already hold 7070.
# PORT=3410
# NEDB_URL=http://127.0.0.1:7075
# IMAGINE_URL=http://127.0.0.1:8085

# ---- pre-reset baseline ----
# 2026-08-14: a compromised DigitalOcean API key let someone rebuild the box.
# The NEDB store went with it; ~997 people had played and there was no usable
# snapshot. These offsets are added ONLY to the three world-facing counters
# (total visitors, your visitor number, how many reached the end). Behavioural
# figures -- funnel, median dwell, quotes, chairs, drawings -- stay measured
# from the surviving log, because a baseline cannot supply them and faking them
# is what would actually break the room. Defaults are 0, so this never travels
# into a fresh install. See engine/src/baseline.ts.
# SHOCKME_BASELINE_VISITORS=997
# SHOCKME_BASELINE_SESSIONS=1140
# SHOCKME_BASELINE_FINISHED=107
# SHOCKME_BASELINE_LOST_ON=2026-08-14
# ---- the voice: which route writes the room ----
# llamacpp = local llama-server on IMAGINE_URL (default; ~1s per line)
# aias     = AiAS gateway -> PIN -> Muse        (~20s per line, better lines)
# SHOCKME_IMAGINE_PROVIDER=llamacpp

# Only read when SHOCKME_IMAGINE_PROVIDER=aias.
# The provider header is MANDATORY — without it the gateway misroutes to Groq
# and returns a 400 about a Claude model, which looks like anything but a
# missing header. muse-local:latest is NOT in /v1/models and works anyway;
# PIN operators come and go, so the catalogue is a snapshot, not the truth.
# AIASSIST_API_KEY=
# AIASSIST_BASE_URL=https://api.aiassist.net
# AIASSIST_PROVIDER=pin
# AIASSIST_MODEL=muse-local:latest
# AIASSIST_TIMEOUT_MS=90000
